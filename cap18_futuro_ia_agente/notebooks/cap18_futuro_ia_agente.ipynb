   "source": [
    "# Ejemplo de agente colaborativo con CrewAI\n",
    "# NOTA: Requiere API key de OpenAI\n",
    "\n",
    "def crear_tripulacion_analisis():\n",
    "    \"\"\"\n",
    "    Crea una tripulación de agentes para análisis completo de datos.\n",
    "    \n",
    "    Agentes:\n",
    "    1. Analista de Datos: Explora y limpia\n",
    "    2. Científico de Datos: Modela y predice\n",
    "    3. Consultor de Negocio: Interpreta hallazgos\n",
    "    \"\"\"\n",
    "    # Definir agentes\n",
    "    analista = Agent(\n",
    "        role='Analista de Datos Senior',\n",
    "        goal='Explorar y limpiar datasets para garantizar calidad',\n",
    "        backstory='''Experto en data wrangling con 10 años de experiencia.\n",
    "        Especialista en detectar problemas de calidad de datos.''',\n",
    "        llm=ChatOpenAI(model='gpt-4'),\n",
    "        verbose=True,\n",
    "        allow_delegation=False\n",
    "    )\n",
    "    \n",
    "    cientifico = Agent(\n",
    "        role='Científico de Datos',\n",
    "        goal='Desarrollar modelos predictivos y analizar patrones',\n",
    "        backstory='''Maestría en Machine Learning. Experiencia en\n",
    "        modelado estadístico y aprendizaje automático.''',\n",
    "        llm=ChatOpenAI(model='gpt-4'),\n",
    "        verbose=True,\n",
    "        allow_delegation=False\n",
    "    )\n",
    "    \n",
    "    consultor = Agent(\n",
    "        role='Consultor de Negocio',\n",
    "        goal='Traducir hallazgos técnicos en recomendaciones actionables',\n",
    "        backstory='''MBA con experiencia en consultoría estratégica.\n",
    "        Experto en comunicar datos a stakeholders no técnicos.''',\n",
    "        llm=ChatOpenAI(model='gpt-4'),\n",
    "        verbose=True,\n",
    "        allow_delegation=False\n",
    "    )\n",
    "    \n",
    "    # Definir tareas\n",
    "    tarea_exploracion = Task(\n",
    "        description='''Analiza el dataset de ventas:\n",
    "        1. Carga y explora la estructura\n",
    "        2. Identifica valores nulos y duplicados\n",
    "        3. Calcula estadísticas descriptivas\n",
    "        4. Detecta outliers en monto_total y cantidad\n",
    "        5. Genera un reporte de calidad de datos''',\n",
    "        agent=analista,\n",
    "        expected_output='Reporte completo de exploración con hallazgos clave'\n",
    "    )\n",
    "    \n",
    "    tarea_modelado = Task(\n",
    "        description='''Basado en la exploración:\n",
    "        1. Identifica las variables más relevantes\n",
    "        2. Propone un modelo predictivo para beneficio\n",
    "        3. Evalúa la viabilidad del modelado\n",
    "        4. Recomienda features adicionales''',\n",
    "        agent=cientifico,\n",
    "        expected_output='Análisis de viabilidad y recomendaciones de modelado'\n",
    "    )\n",
    "    \n",
    "    tarea_recomendaciones = Task(\n",
    "        description='''Integra los hallazgos del analista y el científico:\n",
    "        1. Resume los hallazgos clave en lenguaje de negocio\n",
    "        2. Propone 3 acciones concretas basadas en datos\n",
    "        3. Estima el impacto potencial de cada acción\n",
    "        4. Prioriza las recomendaciones por ROI''',\n",
    "        agent=consultor,\n",
    "        expected_output='3 recomendaciones priorizadas con impacto estimado'\n",
    "    )\n",
    "    \n",
    "    # Crear la tripulación\n",
    "    tripulacion = Crew(\n",
    "        agents=[analista, cientifico, consultor],\n",
    "        tasks=[tarea_exploracion, tarea_modelado, tarea_recomendaciones],\n",
    "        verbose=True\n",
    "    )\n",
    "    \n",
    "    return tripulacion\n",
    "\n",
    "# Ejemplo de uso (comentado porque necesita API key)\n",
    "# tripulacion = crear_tripulacion_analisis()\n",
    "# resultado = tripulacion.kickoff()\n",
    "# print(resultado)\n",
    "\n",
    "print(\"Tripulación configurada. Para ejecutarla, necesitas:\")\n",
    "print(\"1. Instalar crewai: pip install crewai\")\n",
    "print(\"2. Configurar API key: export OPENAI_API_KEY='tu-key'\")\n",
    "print(\"3. Descomentar el código de ejemplo\")"
   ]
