    "## Celda 7: Sistema de Scoring Crediticio con Supervisión Humana"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ejemplo ético: Sistema de aprobación de créditos con supervisión\n",
    "# Demuestra cómo implementar autonomía limitada en decisiones críticas\n",
    "\n",
    "class AgenteCreditoEtico:\n",
    "    \"\"\"\n",
    "    Agente de evaluación crediticia con supervisión humana.\n",
    "    \n",
    "    Principios éticos implementados:\n",
    "    1. Transparencia: Explica cada decisión\n",
    "    2. Supervisión humana: Escala casos ambiguos\n",
    "    3. Auditoría: Registra todas las acciones\n",
    "    4. Limitación de alcance: Solo evalúa créditos\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, umbral_aprobacion=0.7, umbral_rechazo=0.3):\n",
    "        self.umbral_aprobacion = umbral_aprobacion\n",
    "        self.umbral_rechazo = umbral_rechazo\n",
    "        self.historial_decisiones = []\n",
    "    \n",
    "    def evaluar_solicitud(self, solicitud: dict) -> dict:\n",
    "        \"\"\"\n",
    "        Evalúa una solicitud de crédito.\n",
    "        \n",
    "        Parámetros:\n",
    "        - solicitud: dict con ingreso, deudas, historial_crediticio, antiguedad\n",
    "        \"\"\"\n",
    "        # Calcular score de riesgo\n",
    "        riesgo = self._calcular_riesgo(solicitud)\n",
    "        \n",
    "        # Determinar decisión según umbrales\n",
    "        if riesgo > self.umbral_aprobacion:\n",
    "            decision = {\n",
    "                'estado': 'APROBADO_AUTOMATICAMENTE',\n",
    "                'riesgo': round(riesgo, 3),\n",
    "                'accion': 'Proceder con desembolso',\n",
    "                'explicacion': self._generar_explicacion(solicitud, riesgo, 'aprobado'),\n",
    "                'requiere_revision_humana': False\n",
    "            }\n",
    "        elif riesgo < self.umbral_rechazo:\n",
    "            decision = {\n",
    "                'estado': 'RECHAZADO_AUTOMATICAMENTE',\n",
    "                'riesgo': round(riesgo, 3),\n",
    "                'accion': 'Notificar rechazo al cliente',\n",
    "                'explicacion': self._generar_explicacion(solicitud, riesgo, 'rechazado'),\n",
    "                'requiere_revision_humana': False\n",
    "            }\n",
    "        else:\n",
    "            # Zona gris: requiere revisión humana\n",
    "            decision = {\n",
    "                'estado': 'REVISION_HUMANA_REQUERIDA',\n",
    "                'riesgo': round(riesgo, 3),\n",
    "                'accion': 'Escalar a analista senior para revisión',\n",
    "                'explicacion': self._generar_explicacion(solicitud, riesgo, 'revision'),\n",
    "                'requiere_revision_humana': True,\n",
    "                'razon_escalamiento': 'Riesgo en zona gris, requiere juicio humano'\n",
    "            }\n",
    "        \n",
    "        # Registrar en historial\n",
    "        decision['solicitud'] = solicitud\n",
    "        self.historial_decisiones.append(decision)\n",
    "        \n",
    "        return decision\n",
    "    \n",
    "    def _calcular_riesgo(self, solicitud: dict) -> float:\n",
    "        \"\"\"Calcula un score de riesgo basado en la solicitud.\"\"\"\n",
    "        score = 0\n",
    "        \n",
    "        # Factor 1: Ingreso (mayor ingreso = menor riesgo)\n",
    "        score += min(solicitud.get('ingreso', 0) / 100000, 0.3)\n",
    "        \n",
    "        # Factor 2: Deudas (mayor deuda = mayor riesgo)\n",
    "        score -= min(solicitud.get('deudas', 0) / 50000, 0.3)\n",
    "        \n",
    "        # Factor 3: Historial crediticio (mayor historial = menor riesgo)\n",
    "        historial = solicitud.get('historial_crediticio', 500)\n",
    "        score += (historial - 500) / 1000  # Normalizar entre -0.3 y 0.3\n",
    "        \n",
    "        # Factor 4: Antigüedad laboral\n",
    "        score += min(solicitud.get('antiguedad', 0) / 10, 0.2)\n",
    "        \n",
    "        # Normalizar entre 0 y 1\n",
    "        return max(0, min(1, 0.5 + score))\n",
    "    \n",
    "    def _generar_explicacion(self, solicitud: dict, riesgo: float, tipo: str) -> str:\n",
    "        \"\"\"Genera una explicación legible de la decisión.\"\"\"\n",
    "        explicaciones = {\n",
    "            'aprobado': f\"Solicitud aprobada automáticamente. Score de riesgo: {riesgo:.2f} (por encima del umbral {self.umbral_aprobacion}). \"\n",
    "                       f\"Ingreso: ${solicitud.get('ingreso', 0):,.2f}. \"\n",
    "                       f\"Historial crediticio: {solicitud.get('historial_crediticio', 'N/A')}.\",\n",
    "            'rechazado': f\"Solicitud rechazada automáticamente. Score de riesgo: {riesgo:.2f} (por debajo del umbral {self.umbral_rechazo}). \"\n",
    "                       f\"Se recomienda mejorar historial crediticio o reducir deudas.\",\n",
    "            'revision': f\"Solicitud en zona gris. Score de riesgo: {riesgo:.2f} (entre {self.umbral_rechazo} y {self.umbral_aprobacion}). \"\n",
    "                       f\"Requiere revisión humana para decisión final.\"\n",
    "        }\n",
    "        return explicaciones[tipo]\n",
    "\n",
    "# Demostración del agente ético\n",
    "print(\"=\" * 60)\n",
    "print(\"AGENTE DE CRÉDITO ÉTICO - DEMOSTRACIÓN\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "agente = AgenteCreditoEtico()\n",
    "\n",
    "# Caso 1: Cliente de bajo riesgo (aprobado)\n",
    "solicitud_1 = {\n",
    "    'ingreso': 85000,\n",
    "    'deudas': 12000,\n",
    "    'historial_crediticio': 750,\n",
    "    'antiguedad': 5\n",
    "}\n",
    "decision_1 = agente.evaluar_solicitud(solicitud_1)\n",
    "print(f\"\\nCaso 1 - Cliente con buen perfil:\")\n",
    "print(f\"  Estado: {decision_1['estado']}\")\n",
    "print(f\"  Riesgo: {decision_1['riesgo']}\")\n",
    "print(f\"  Requiere revisión: {decision_1['requiere_revision_humana']}\")\n",
    "\n",
    "# Caso 2: Cliente de alto riesgo (rechazado)\n",
    "solicitud_2 = {\n",
    "    'ingreso': 25000,\n",
    "    'deudas': 45000,\n",
    "    'historial_crediticio': 480,\n",
    "    'antiguedad': 1\n",
    "}\n",
    "decision_2 = agente.evaluar_solicitud(solicitud_2)\n",
    "print(f\"\\nCaso 2 - Cliente con riesgo alto:\")\n",
    "print(f\"  Estado: {decision_2['estado']}\")\n",
    "print(f\"  Riesgo: {decision_2['riesgo']}\")\n",
    "print(f\"  Requiere revisión: {decision_2['requiere_revision_humana']}\")\n",
    "\n",
    "# Caso 3: Cliente en zona gris (requiere revisión)\n",
    "solicitud_3 = {\n",
    "    'ingreso': 45000,\n",
    "    'deudas': 28000,\n",
    "    'historial_crediticio': 620,\n",
    "    'antiguedad': 3\n",
    "}\n",
    "decision_3 = agente.evaluar_solicitud(solicitud_3)\n",
    "print(f\"\\nCaso 3 - Cliente en zona gris:\")\n",
    "print(f\"  Estado: {decision_3['estado']}\")\n",
    "print(f\"  Riesgo: {decision_3['riesgo']}\")\n",
    "print(f\"  Requiere revisión: {decision_3['requiere_revision_humana']}\")\n",
    "print(f\"  Razón: {decision_3.get('razon_escalamiento', 'N/A')}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"HISTORIAL DE DECISIONES\")\n",
    "print(\"=\" * 60)\n",
    "for i, decision in enumerate(agente.historial_decisiones, 1):\n",
    "    print(f\"\\nDecision {i}:\")\n",
    "    print(f\"  Explicación: {decision['explicacion']}\")"
   ]
