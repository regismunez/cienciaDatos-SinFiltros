   "source": [
    "## Celda 3: Herramientas para Agentes (Tools)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Definir herramientas que el agente puede usar\n",
    "# Estas funciones están decoradas con @tool para que LangChain las reconozca\n",
    "\n",
    "@tool\n",
    "def cargar_datos(ruta_archivo: str) -> str:\n",
    "    \"\"\"Carga un dataset CSV y retorna información básica: filas, columnas, tipos de datos.\"\"\"\n",
    "    try:\n",
    "        df = pd.read_csv(ruta_archivo)\n",
    "        info = {\n",
    "            'filas': len(df),\n",
    "            'columnas': list(df.columns),\n",
    "            'tipos': {col: str(dtype) for col, dtype in df.dtypes.items()},\n",
    "            'nulos_por_columna': df.isnull().sum().to_dict(),\n",
    "            'memoria_mb': round(df.memory_usage(deep=True).sum() / 1024**2, 2)\n",
    "        }\n",
    "        return json.dumps(info, indent=2, ensure_ascii=False)\n",
    "    except Exception as e:\n",
    "        return f\"Error al cargar datos: {str(e)}\"\n",
    "\n",
    "@tool\n",
    "def estadisticas_descriptivas(ruta_archivo: str) -> str:\n",
    "    \"\"\"Genera estadísticas descriptivas completas del dataset (mean, std, min, max, quartiles).\"\"\"\n",
    "    try:\n",
    "        df = pd.read_csv(ruta_archivo)\n",
    "        return df.describe(include='all').to_string()\n",
    "    except Exception as e:\n",
    "        return f\"Error al generar estadísticas: {str(e)}\"\n",
    "\n",
    "@tool\n",
    "def detectar_outliers(ruta_archivo: str, columna: str) -> str:\n",
    "    \"\"\"Detecta outliers en una columna numérica usando el método IQR (Rango Intercuartílico).\"\"\"\n",
    "    try:\n",
    "        df = pd.read_csv(ruta_archivo)\n",
    "        if columna not in df.columns:\n",
    "            return f\"Error: La columna '{columna}' no existe. Columnas disponibles: {list(df.columns)}\"\n",
    "        if not pd.api.types.is_numeric_dtype(df[columna]):\n",
    "            return f\"Error: La columna '{columna}' no es numérica\"\n",
    "        \n",
    "        Q1 = df[columna].quantile(0.25)\n",
    "        Q3 = df[columna].quantile(0.75)\n",
    "        IQR = Q3 - Q1\n",
    "        outliers = df[(df[columna] < Q1 - 1.5*IQR) | (df[columna] > Q3 + 1.5*IQR)]\n",
    "        \n",
    "        resultado = {\n",
    "            'columna_analizada': columna,\n",
    "            'total_registros': len(df),\n",
    "            'outliers_encontrados': len(outliers),\n",
    "            'porcentaje_outliers': round(len(outliers)/len(df)*100, 2),\n",
    "            'Q1': round(Q1, 2),\n",
    "            'Q3': round(Q3, 2),\n",
    "            'IQR': round(IQR, 2),\n",
    "            'limite_inferior': round(Q1 - 1.5*IQR, 2),\n",
    "            'limite_superior': round(Q3 + 1.5*IQR, 2)\n",
    "        }\n",
    "        return json.dumps(resultado, indent=2)\n",
    "    except Exception as e:\n",
    "        return f\"Error al detectar outliers: {str(e)}\"\n",
    "\n",
    "@tool\n",
    "def generar_grafico(ruta_archivo: str, tipo_grafico: str, columna_x: str, columna_y: str) -> str:\n",
    "    \"\"\"Genera un gráfico (barras, dispersion, linea) y lo guarda como imagen.\"\"\"\n",
    "    try:\n",
    "        df = pd.read_csv(ruta_archivo)\n",
    "        \n",
    "        plt.figure(figsize=(10, 6))\n",
    "        \n",
    "        if tipo_grafico == 'barras':\n",
    "            df.groupby(columna_x)[columna_y].sum().plot(kind='bar')\n",
    "        elif tipo_grafico == 'dispersion':\n",
    "            plt.scatter(df[columna_x], df[columna_y], alpha=0.5)\n",
    "        elif tipo_grafico == 'linea':\n",
    "            df.groupby(columna_x)[columna_y].sum().plot(kind='line')\n",
    "        else:\n",
    "            return f\"Tipo de gráfico no soportado: {tipo_grafico}. Opciones: barras, dispersion, linea\"\n",
    "        \n",
    "        plt.title(f'{tipo_grafico.capitalize()}: {columna_y} vs {columna_x}')\n",
    "        plt.xlabel(columna_x)\n",
    "        plt.ylabel(columna_y)\n",
    "        plt.tight_layout()\n",
    "        \n",
    "        ruta_grafico = f'../datos/grafico_{tipo_grafico}_{columna_x}.png'\n",
    "        plt.savefig(ruta_grafico, dpi=100)\n",
    "        plt.close()\n",
    "        \n",
    "        return f\"Gráfico guardado en: {ruta_grafico}\"\n",
    "    except Exception as e:\n",
    "        return f\"Error al generar gráfico: {str(e)}\"\n",
    "\n",
    "print(\"Herramientas definidas:\")\n",
    "print(\"  1. cargar_datos: Información básica del dataset\")\n",
    "print(\"  2. estadisticas_descriptivas: Estadísticas completas\")\n",
    "print(\"  3. detectar_outliers: Detección de valores atípicos\")\n",
    "print(\"  4. generar_grafico: Creación de visualizaciones\")"
   ]
  },
