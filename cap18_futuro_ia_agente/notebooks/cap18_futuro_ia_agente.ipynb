    "## Celda 6: Grafo de Estados con LangGraph"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ejemplo de agente como grafo de estados con LangGraph\n",
    "# Este enfoque es ideal para flujos complejos con ramas y bucles\n",
    "\n",
    "def crear_grafo_analisis():\n",
    "    \"\"\"\n",
    "    Crea un grafo de estados para análisis de datos.\n",
    "    \n",
    "    Estados:\n",
    "    1. inicio → Carga datos\n",
    "    2. carga → Exploración\n",
    "    3. exploración → Limpieza\n",
    "    4. limpieza → Análisis\n",
    "    5. análisis → Generación de reporte\n",
    "    6. reporte → fin\n",
    "    \"\"\"\n",
    "    # Definir el estado\n",
    "    class EstadoAnalisis(TypedDict):\n",
    "        ruta_archivo: str\n",
    "        datos_cargados: bool\n",
    "        exploracion_completada: bool\n",
    "        limpieza_completada: bool\n",
    "        analisis_completado: bool\n",
    "        reporte_generado: bool\n",
    "        historial: Annotated[list, operator.add]\n",
    "    \n",
    "    # Definir nodos (funciones)\n",
    "    def cargar_datos(state: EstadoAnalisis) -> EstadoAnalisis:\n",
    "        \"\"\"Carga el dataset y verifica su estructura.\"\"\"\n",
    "        try:\n",
    "            df = pd.read_csv(state['ruta_archivo'])\n",
    "            return {\n",
    "                'datos_cargados': True,\n",
    "                'historial': [f'Datos cargados: {len(df)} filas, {len(df.columns)} columnas']\n",
    "            }\n",
    "        except Exception as e:\n",
    "            return {\n",
    "                'datos_cargados': False,\n",
    "                'historial': [f'Error al cargar datos: {str(e)}']\n",
    "            }\n",
    "    \n",
    "    def explorar_datos(state: EstadoAnalisis) -> EstadoAnalisis:\n",
    "        \"\"\"Realiza exploración inicial del dataset.\"\"\"\n",
    "        if not state.get('datos_cargados'):\n",
    "            return {'historial': ['No se pueden explorar datos: no fueron cargados']}\n",
    "        \n",
    "        df = pd.read_csv(state['ruta_archivo'])\n",
    "        nulos = df.isnull().sum().sum()\n",
    "        duplicados = df.duplicated().sum()\n",
    "        \n",
    "        return {\n",
    "            'exploracion_completada': True,\n",
    "            'historial': [\n",
    "                f'Exploración completada: {nulos} valores nulos, {duplicados} duplicados'\n",
    "            ]\n",
    "        }\n",
    "    \n",
    "    def limpiar_datos(state: EstadoAnalisis) -> EstadoAnalisis:\n",
    "        \"\"\"Limpia el dataset: elimina duplicados y maneja nulos.\"\"\"\n",
    "        if not state.get('exploracion_completada'):\n",
    "            return {'historial': ['No se pueden limpiar datos: exploración no completada']}\n",
    "        \n",
    "        df = pd.read_csv(state['ruta_archivo'])\n",
    "        df_limpio = df.drop_duplicates()\n",
    "        \n",
    "        # Rellenar nulos numéricos con la media\n",
    "        for col in df_limpio.select_dtypes(include=[np.number]).columns:\n",
    "            df_limpio[col] = df_limpio[col].fillna(df_limpio[col].mean())\n",
    "        \n",
    "        # Guardar dataset limpio\n",
    "        ruta_limpia = state['ruta_archivo'].replace('.csv', '_limpio.csv')\n",
    "        df_limpio.to_csv(ruta_limpia, index=False)\n",
    "        \n",
    "        return {\n",
    "            'limpieza_completada': True,\n",
    "            'historial': [\n",
    "                f'Limpieza completada: {len(df)} → {len(df_limpio)} filas. Guardado en: {ruta_limpia}'\n",
    "            ]\n",
    "        }\n",
    "    \n",
    "    def analizar_datos(state: EstadoAnalisis) -> EstadoAnalisis:\n",
    "        \"\"\"Realiza análisis estadístico del dataset limpio.\"\"\"\n",
    "        if not state.get('limpieza_completada'):\n",
    "            return {'historial': ['No se pueden analizar datos: limpieza no completada']}\n",
    "        \n",
    "        ruta_limpia = state['ruta_archivo'].replace('.csv', '_limpio.csv')\n",
    "        df = pd.read_csv(ruta_limpia)\n",
    "        \n",
    "        estadisticas = df.describe().to_string()\n",
    "        \n",
    "        return {\n",
    "            'analisis_completado': True,\n",
    "            'historial': [\n",
    "                f'Análisis completado. Estadísticas generadas.'\n",
    "            ]\n",
    "        }\n",
    "    \n",
    "    def generar_reporte(state: EstadoAnalisis) -> EstadoAnalisis:\n",
    "        \"\"\"Genera un reporte final del análisis.\"\"\"\n",
    "        if not state.get('analisis_completado'):\n",
    "            return {'historial': ['No se puede generar reporte: análisis no completado']}\n",
    "        \n",
    "        reporte = {\n",
    "            'estado_final': 'Análisis completado exitosamente',\n",
    "            'pasos_completados': [\n",
    "                'Carga de datos',\n",
    "                'Exploración',\n",
    "                'Limpieza',\n",
    "                'Análisis',\n",
    "                'Reporte'\n",
    "            ]\n",
    "        }\n",
    "        \n",
    "        return {\n",
    "            'reporte_generado': True,\n",
    "            'historial': [\n",
    "                f'Reporte generado: {json.dumps(reporte, indent=2)}'\n",
    "            ]\n",
    "        }\n",
    "    \n",
    "    # Construir el grafo\n",
    "    graph = StateGraph(EstadoAnalisis)\n",
    "    \n",
    "    # Agregar nodos\n",
    "    graph.add_node('cargar', cargar_datos)\n",
    "    graph.add_node('explorar', explorar_datos)\n",
    "    graph.add_node('limpiar', limpiar_datos)\n",
    "    graph.add_node('analizar', analizar_datos)\n",
    "    graph.add_node('reportar', generar_reporte)\n",
    "    \n",
    "    # Definir flujo\n",
    "    graph.set_entry_point('cargar')\n",
    "    graph.add_edge('cargar', 'explorar')\n",
    "    graph.add_edge('explorar', 'limpiar')\n",
    "    graph.add_edge('limpiar', 'analizar')\n",
    "    graph.add_edge('analizar', 'reportar')\n",
    "    graph.add_edge('reportar', END)\n",
    "    \n",
    "    # Compilar\n",
    "    app = graph.compile()\n",
    "    \n",
    "    return app\n",
    "\n",
    "# Ejecutar el grafo\n",
    "grafo = crear_grafo_analisis()\n",
    "resultado = grafo.invoke({\n",
    "    'ruta_archivo': '../datos/datos_ventas_simuladas.csv',\n",
    "    'datos_cargados': False,\n",
    "    'exploracion_completada': False,\n",
    "    'limpieza_completada': False,\n",
    "    'analisis_completado': False,\n",
    "    'reporte_generado': False,\n",
    "    'historial': []\n",
    "})\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"HISTORIAL DEL GRAFO\")\n",
    "print(\"=\" * 60)\n",
    "for paso in resultado['historial']:\n",
    "    print(f\"  → {paso}\")"
   ]
