    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "import json\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# LangChain para agentes\n",
    "try:\n",
    "    from langchain.agents import AgentExecutor, create_openai_tools_agent\n",
    "    from langchain_openai import ChatOpenAI\n",
    "    from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder\n",
    "    from langchain_core.tools import tool\n",
    "    print('LangChain disponible')\n",
    "except ImportError:\n",
    "    print('LangChain no instalado. Instalar con: pip install langchain langchain-openai')\n",
    "\n",
    "# CrewAI para agentes colaborativos\n",
    "try:\n",
    "    from crewai import Agent, Task, Crew\n",
    "    print('CrewAI disponible')\n",
    "except ImportError:\n",
    "    print('CrewAI no instalado. Instalar con: pip install crewai')\n",
    "\n",
    "# LangGraph para grafos de estados\n",
    "try:\n",
    "    from langgraph.graph import StateGraph, END\n",
    "    from typing import TypedDict, Annotated\n",
    "    import operator\n",
    "    print('LangGraph disponible')\n",
    "except ImportError:\n",
    "    print('LangGraph no instalado. Instalar con: pip install langgraph')\n",
    "\n",
    "# Scikit-learn para modelos\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import accuracy_score, classification_report\n",
    "\n",
    "pd.set_option('display.max_columns', 25)\n",
    "pd.set_option('display.max_colwidth', 100)\n",
    "np.random.seed(42)\n",
    "print('\\nLibrerías cargadas correctamente.')"
   ]
