    "## Celda 4: Agente Simple con LangChain"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configurar el agente con LangChain\n",
    "# NOTA: Necesitas una API key de OpenAI para ejecutar este código\n",
    "# export OPENAI_API_KEY='tu-api-key-aqui'\n",
    "\n",
    "def crear_agente_analisis():\n",
    "    \"\"\"\n",
    "    Crea un agente de análisis de datos con LangChain.\n",
    "    \n",
    "    El agente puede:\n",
    "    - Cargar y explorar datasets\n",
    "    - Calcular estadísticas descriptivas\n",
    "    - Detectar outliers\n",
    "    - Generar gráficos\n",
    "    \"\"\"\n",
    "    # Configurar el modelo de lenguaje\n",
    "    llm = ChatOpenAI(model='gpt-4', temperature=0)\n",
    "    \n",
    "    # Definir el prompt del agente\n",
    "    prompt = ChatPromptTemplate.from_messages([\n",
    "        ('system', \"\"\"Eres un analista de datos experto y metódico.\n",
    "        \n",
    "        Tu trabajo es analizar datasets usando las herramientas disponibles.\n",
    "        Siempre:\n",
    "        1. Primero carga los datos para entender su estructura\n",
    "        2. Luego genera estadísticas descriptivas\n",
    "        3. Detecta outliers si es relevante\n",
    "        4. Genera visualizaciones cuando sea útil\n",
    "        \n",
    "        Explica tus hallazgos de forma clara y concisa.\n",
    "        Siempre termina con una recomendación actionable.\"\"\"),\n",
    "        MessagesPlaceholder(variable_name='chat_history'),\n",
    "        ('human', '{input}'),\n",
    "        MessagesPlaceholder(variable_name='agent_scratchpad'),\n",
    "    ])\n",
    "    \n",
    "    # Configurar herramientas\n",
    "    herramientas = [cargar_datos, estadisticas_descriptivas, detectar_outliers, generar_grafico]\n",
    "    \n",
    "    # Crear el agente\n",
    "    agente = create_openai_tools_agent(llm, herramientas, prompt)\n",
    "    \n",
    "    # Crear el executor\n",
    "    executor = AgentExecutor(\n",
    "        agent=agente,\n",
    "        tools=herramientas,\n",
    "        verbose=True,\n",
    "        max_iterations=10,\n",
    "        handle_parsing_errors=True\n",
    "    )\n",
    "    \n",
    "    return executor\n",
    "\n",
    "# Ejemplo de uso (comentado porque necesita API key)\n",
    "# agente = crear_agente_analisis()\n",
    "# respuesta = agente.invoke({\n",
    "#     'input': 'Analiza el dataset de ventas y dime: 1) Cuántos registros tiene, 2) Cuáles son las estadísticas de monto_total, 3) Hay outliers en cantidad?',\n",
    "#     'chat_history': []\n",
    "# })\n",
    "# print(respuesta['output'])\n",
    "\n",
    "print(\"Agente configurado. Para ejecutarlo, necesitas:\")\n",
    "print(\"1. Instalar langchain: pip install langchain langchain-openai\")\n",
    "print(\"2. Configurar API key: export OPENAI_API_KEY='tu-key'\")\n",
    "print(\"3. Descomentar el código de ejemplo\")"
   ]
