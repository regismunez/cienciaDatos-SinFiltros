   "source": [
    "# Crear dataset de ventas simuladas para el ejemplo\n",
    "np.random.seed(42)\n",
    "n_registros = 500\n",
    "\n",
    "datos_ventas = {\n",
    "    'fecha': pd.date_range('2024-01-01', periods=n_registros, freq='D'),\n",
    "    'producto': np.random.choice(['Laptop', 'Mouse', 'Teclado', 'Monitor', 'Auriculares'], n_registros),\n",
    "    'cantidad': np.random.randint(1, 20, n_registros),\n",
    "    'precio_unitario': np.random.uniform(20, 1500, n_registros).round(2),\n",
    "    'region': np.random.choice(['Norte', 'Sur', 'Este', 'Oeste'], n_registros),\n",
    "    'canal_venta': np.random.choice(['Online', 'Tienda', 'Mayorista'], n_registros)\n",
    "}\n",
    "\n",
    "df_ventas = pd.DataFrame(datos_ventas)\n",
    "df_ventas['monto_total'] = (df_ventas['cantidad'] * df_ventas['precio_unitario']).round(2)\n",
    "df_ventas['costo_envio'] = np.random.uniform(5, 50, n_registros).round(2)\n",
    "df_ventas['beneficio'] = (df_ventas['monto_total'] * np.random.uniform(0.1, 0.3, n_registros)).round(2)\n",
    "\n",
    "# Introducir algunos valores nulos para realismo\n",
    "df_ventas.loc[np.random.choice(df_ventas.index, 15), 'costo_envio'] = np.nan\n",
    "df_ventas.loc[np.random.choice(df_ventas.index, 8), 'beneficio'] = np.nan\n",
    "\n",
    "df_ventas.to_csv('../datos/datos_ventas_simuladas.csv', index=False)\n",
    "\n",
    "print(f\"Dataset creado: {df_ventas.shape[0]} filas, {df_ventas.shape[1]} columnas\")\n",
    "print(f\"\\nPrimeras 5 filas:\")\n",
    "df_ventas.head()"
   ]
